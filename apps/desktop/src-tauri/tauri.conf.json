{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Local Office",
  "mainBinaryName": "my-local-office",
  "version": "0.0.0",
  "identifier": "io.github.alissonpelizaro.my-local-office",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Claude Code agents working together in a local virtual office",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": { "app/": "app/" },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
